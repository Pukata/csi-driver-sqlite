FROM debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update && apt-get install -y --no-install-recommends samba && rm -rf /var/lib/apt/lists/* && mkdir -p /export /run/samba && useradd --system --no-create-home sqlite
COPY test/nas/smb.conf /etc/samba/smb.conf
COPY test/nas/smb-entrypoint.sh /usr/local/bin/smb-entrypoint
ENTRYPOINT ["/bin/sh", "/usr/local/bin/smb-entrypoint"]
